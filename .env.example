# ==========================================
# SensorGuard Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB Atlas / MongoDB Time Series
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sensorguard?retryWrites=true&w=majority
# Example Local URI: mongodb://127.0.0.1:27017/sensorguard
MONGODB_URI=mongodb://127.0.0.1:27017/sensorguard
MONGODB_DB_NAME=sensorguard
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Redis & BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
WORKER_CONCURRENCY=8
TELEMETRY_ATTEMPTS=5
TELEMETRY_BACKOFF_MS=1000
READING_CACHE_TTL_SECONDS=300
WORKER_SHUTDOWN_TIMEOUT_MS=60000
SENSOR_HEALTH_INTERVAL_MS=30000
SENSOR_OFFLINE_AFTER_SECONDS=120
DETECTION_RECOVERY_READINGS=3
DETECTION_HYSTERESIS_PERCENT=5
TELEMETRY_MAX_FUTURE_SECONDS=300

# Authentication
API_KEY=sensorguard-secret-api-key

# Note: Datadog / APM integration is deferred and NOT required for Phase 1.
